# Trusted Supabase Edge Function values only. Copy to the ignored
# supabase/.env.local for local development; never use EXPO_PUBLIC_* names here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_FOUNDING_BETA_PRICE_ID=
DERIVE_CHECKOUT_SUCCESS_URL=
DERIVE_CHECKOUT_CANCEL_URL=
DERIVE_PORTAL_RETURN_URL=
GEMINI_API_KEY=
GEMINI_MODEL=
ROUTINE_MODEL_PROVIDER=
ADMIN_ALLOWED_ORIGINS=
# Server-only first-party event intake. Keep false until privacy/retention approval.
MEASUREMENT_INGRESS_ENABLED=
# DailyMed SPL link candidate lookup. Defaults off; enable only after #161
# external-lookup budget migration, hosted function parity, and customer-copy review.
DERIVE_DAILYMED_LINK_ENABLED=
# UPCitemdb free trial: private evaluation only, no API key required.
# Empty values disable lookup. Tester IDs are exact local/approved Auth UUIDs.
DERIVE_UPC_PRIVATE_TEST_ENABLED=
DERIVE_UPC_PRIVATE_TESTER_IDS=
