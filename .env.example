# Supabase Credentials (Required for remote sync & private photo storage)
# The anon key is a public client credential, not a secret. Never put the
# service-role key or any other server secret in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Toggle the mobile client from MockDeriveService to RemoteDeriveService.
EXPO_PUBLIC_USE_REMOTE_SERVICE=false

# Gemini credentials MUST NOT live in the Expo client.
# Real Gemini invocation belongs in the trusted Supabase/server environment
# (Sami). Store GEMINI_API_KEY as a server/Edge Function secret only.
# Never expose a Gemini key via EXPO_PUBLIC_* variables.
