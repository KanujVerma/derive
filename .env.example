# Supabase Credentials (Required for remote sync & private photo storage)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Gemini AI API Key (Required for live multimodal vision & chat)
# Note: When empty, Derive automatically operates with intelligent local deterministic reasoning.
EXPO_PUBLIC_GEMINI_API_KEY=your-gemini-api-key
