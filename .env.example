# Copy this file to .env.local. These values are compiled into the Expo app,
# so this template intentionally contains public mobile configuration only.
# Server and deployment variable names are inventoried in docs/ENVIRONMENT.md.
EXPO_PUBLIC_USE_REMOTE_SERVICE=false
EXPO_PUBLIC_BUILD_FLAVOR=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# S7 analytics stays off unless enabled in an approved Remote build AND the
# customer explicitly opts in through the app's privacy choice (not yet wired).
# PostHog Project Settings -> General -> Project token & ID (public phc_ token).
# For Derive's verified US Cloud project, host is https://us.i.posthog.com.
# Do not use Account -> Personal API keys or Project secret API keys here.
EXPO_PUBLIC_ANALYTICS_ENABLED=
EXPO_PUBLIC_POSTHOG_PROJECT_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
# Optional: set only after the customer support mailbox has been tested.
EXPO_PUBLIC_FOUNDER_SUPPORT_EMAIL=
