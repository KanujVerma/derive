# Copy this file to .env.local. These values are compiled into the Expo app,
# so this template intentionally contains public mobile configuration only.
# Server and deployment variable names are inventoried in docs/ENVIRONMENT.md.
EXPO_PUBLIC_USE_REMOTE_SERVICE=false
EXPO_PUBLIC_BUILD_FLAVOR=
# Leave blank normally. scanner-release EAS profile sets true only for the
# exact reviewed hosted project; it does not deploy or activate the backend.
EXPO_PUBLIC_SCANNER_RELEASE_ENABLED=

# Private local UPC phone trial only; ignored outside development JS + flavor.
# Public presentation flag, never an API key or server authorization.
EXPO_PUBLIC_PRIVATE_UPC_TEST_ENABLED=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional physical QA only: exact Mac private IPv4 HTTP base URL, port 54321.
# Must match SUPABASE_URL; requires development flavor + a development JS runtime.
# Leave blank for ordinary UI work, staging, production and release exports.
EXPO_PUBLIC_DEV_SUPABASE_LAN_URL=
# Optional: set only after the customer support mailbox has been tested.
EXPO_PUBLIC_FOUNDER_SUPPORT_EMAIL=
