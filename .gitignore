# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo & Metro
.expo/
dist/
dist-web/
web-build/
expo-env.d.ts
.metro-health-check*

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
/ios
/android

# debug & logs
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS & system
.DS_Store
*.pem

# local env files (never commit real credentials)
.env
.env.*
!.env.example

# Supabase CLI local state
supabase/.temp/
supabase/.branches/

# typescript
*.tsbuildinfo

# local agent / IDE state
.claude/
.system_generated/
*.log
