{
  "expo": {
    "name": "Derive",
    "slug": "derive",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "derive",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.derive.skincare",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Derive uses your camera to scan skincare product barcodes and capture product or skin photos you choose.",
        "NSPhotoLibraryUsageDescription": "Derive uses photos you choose from your library to add products to your shelf or attach an image to a message."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F3EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4100d696-3e03-4b2c-bdb3-1986d5f1a624"
      }
    },
    "owner": "derive-skincare"
  }
}
