{
  "cli": {
    "version": ">= 24.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_USE_REMOTE_SERVICE": "false",
        "EXPO_PUBLIC_BUILD_FLAVOR": "development"
      }
    },
    "remote-staging": {
      "autoIncrement": true,
      "distribution": "store",
      "environment": "preview",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_USE_REMOTE_SERVICE": "true",
        "EXPO_PUBLIC_BUILD_FLAVOR": "remote-staging"
      }
    },
    "scanner-release": {
      "autoIncrement": true,
      "distribution": "store",
      "environment": "production",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_USE_REMOTE_SERVICE": "true",
        "EXPO_PUBLIC_BUILD_FLAVOR": "production",
        "EXPO_PUBLIC_SCANNER_RELEASE_ENABLED": "true",
        "EXPO_PUBLIC_PART_ONE_ENABLED": "true",
        "EXPO_PUBLIC_PART_TWO_ENABLED": "true",
        "EXPO_PUBLIC_PART_THREE_ENABLED": "true",
        "EXPO_PUBLIC_PART_FOUR_SCIENCE": "reviewed_public_usefulness"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "environment": "production",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_USE_REMOTE_SERVICE": "false",
        "EXPO_PUBLIC_BUILD_FLAVOR": "production"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6813524447"
      }
    }
  }
}
